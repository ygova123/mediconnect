{
  "rules": {
    ".read": false,
    ".write": false,
    "hospitals": {
      ".read": true,
      "$hospitalId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "images": {
          "$imageIndex": {
            ".validate": "$imageIndex.matches(/^[0-3]$/) && newData.isString() && newData.val().length <= 500000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+/=]+$/)"
          }
        }
      }
    },
    "cities": {
      ".read": true,
      "$cityId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "tags": {
      ".read": true,
      "$tagId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "dietPlans": {
      ".read": true,
      "$planId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "dietQuestions": {
      ".read": true,
      "$questionKind": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "pcosGuide": {
      ".read": true,
      "$guideId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "pcosPlans": {
      ".read": true,
      "$planId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "contentMeta": {
      ".read": true,
      "$metaKey": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
